# Configuración de ejemplo para variables de entorno
# Copiar a .env y configurar con valores reales

# Puerto del servidor
PORT=3000

# URL de conexión a MongoDB
MONGODB_URI=mongodb://localhost:27017/contactapp

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Configuraciones opcionales
# DEBUG=true
# LOG_LEVEL=info